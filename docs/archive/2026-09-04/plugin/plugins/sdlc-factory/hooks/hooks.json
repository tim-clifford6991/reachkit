{
  "description": "Makes constitution §4 and §9 enforceable rather than advisory: re-states the routing rules every turn, and refuses corpus writes that did not come from the owning agent.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/route-prompt.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-corpus-write.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
