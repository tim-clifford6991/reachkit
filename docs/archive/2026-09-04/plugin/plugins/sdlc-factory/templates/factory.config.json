{
  "docsRoot": "sdlc-factory/docs",

  "grammar": "front-matter",

  "types": [
    { "id": "REQ", "dir": "requirements", "label": "Requirements", "durability": "durable" },
    { "id": "BP",  "dir": "blueprints",   "label": "Blueprints",   "durability": "derived" },
    { "id": "WO",  "dir": "work-orders",  "label": "Work Orders",  "durability": "derived" },
    { "id": "ADR", "dir": "decisions",    "label": "Decisions",    "durability": "durable" },
    { "id": "FB",  "dir": "feedback",     "label": "Feedback",     "durability": "durable" },
    { "id": "JN",  "dir": "journeys",     "label": "Journeys",     "durability": "durable" }
  ],

  "externalIdPrefixes": ["TST"],

  "relations": {
    "Implements":   "implements",
    "Satisfies":    "satisfies",
    "Satisfied by": "satisfied-by",
    "Depends on":   "depends-on",
    "Blocks":       "blocks",
    "Blocked by":   "blocked-by",
    "Parent":       "parent",
    "ADRs":         "cites-adr",
    "Related":      "related",
    "Gates":        "gates"
  },

  "edges": {
    "satisfies":   { "from": ["blueprint"],  "to": ["requirement"] },
    "covers":      { "from": ["blueprint"],  "to": ["requirement"] },
    "implements":  { "from": ["work-order"], "to": ["blueprint", "requirement", "decision"] },
    "decides-for": { "from": ["decision"],   "to": ["requirement", "blueprint", "work-order", "charter"] },
    "about":       { "from": ["feedback"],   "to": ["requirement", "blueprint", "work-order", "decision"] },
    "depends-on":  { "from": ["*"], "to": ["*"] },
    "blocked-by":  { "from": ["*"], "to": ["*"] },
    "supersedes":  { "from": ["*"], "to": ["same"] },
    "validates":   { "from": ["validation"], "to": ["work-order"] },
    "exercises":   { "from": ["journey"],    "to": ["requirement"] }
  },

  "statuses": {
    "artifact": ["draft", "in-review", "approved", "superseded"],
    "WO":       ["draft", "in-review", "approved", "superseded", "done"],
    "ADR":      ["proposed", "accepted", "superseded"],
    "registry": ["open", "resolved", "struck", "removed"],

    "observed": {
      "artifact": ["triaged"],
      "registry": ["reserved", "confirmed", "refuted", "retired", "unconfirmed"]
    },

    "requirement": ["draft", "in-review", "approved", "superseded"],
    "blueprint":   ["draft", "in-review", "approved", "superseded"],
    "work-order":  ["draft", "in-review", "approved", "superseded", "done"],
    "decision":    ["proposed", "accepted", "superseded"],
    "validation":  ["pass", "pass-with-findings", "fail", "reject", "approve", "approve-with-findings", "blocked", "unknown"],
    "feedback":    ["open", "routed", "merged-into", "closed"],
    "journey":     ["draft", "in-review", "approved", "superseded"]
  },

  "fields": {
    "UI": {
      "key": "UI",
      "type": "boolean",
      "true": ["yes"],
      "false": ["no"],
      "tolerate": { "true": ["true", "touches"], "false": ["n", "false"] }
    }
  },

  "metaFields": ["Priority", "Tag", "Branch", "Estimate", "Date", "Verdict", "Approved by", "Preview", "Signed-off"],
  "knownKeys": ["Owns capabilities", "Source", "Implemented by", "Pinned by"],

  "traceability": { "file": "registry/traceability.md", "types": ["REQ", "BP", "WO"] },

  "structureMap": "registry/structure.md",
  "charter": "00-project.md",

  "archive": "archive",

  "schema": null,

  "code": { "root": "." },

  "checks": {
    "orphanType": "REQ",
    "silentIndexThreshold": 0.05,
    "workOrdersPerRequirement": 6,
    "wordsPerApprovedRequirement": 6000,
    "linesPerWorkOrder": 150,
    "openAssumptionsPerApproved": 0.5,
    "severity": {
      "dangling-id": "error",
      "registry-contradiction": "error",
      "generated-drift": "error",
      "status-off-grammar": "warn",
      "field-vocabulary": "warn",
      "ellipsis-range": "warn",
      "orphan-requirement": "warn",
      "done-without-validation": "error",
      "silent-index": "warn",
      "tst-heading-off-grammar": "warn",
      "edge-off-schema": "warn",
      "requirement-off-journey": "warn",
      "stale-blueprint": "warn",
      "untraced-change": "warn",
      "done-without-commits": "error",
      "wave-off-record": "warn",
      "tst-without-regression": "warn",
      "preview-without-url": "warn",
      "high-risk-without-mutation": "error",
      "satisfies-superseded": "warn",
      "work-order-fanout": "warn",
      "corpus-volume": "warn",
      "assumption-budget": "warn",
      "open-assumption-on-done": "error",
      "pivot-relink": "warn",
      "minted-open-assumption": "warn"
    }
  },

  "bodyCap": null,
  "rowCap": null,
  "charterCap": null
}
