{
  "name": "factory-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only console for an SDLC Factory corpus: parser, conformance checker and viewer.",
  "bin": {
    "factory-console": "bin/factory-console.mjs",
    "factory": "bin/factory-console.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "gate": "node test/gate.mjs",
    "gate:fm": "node test/gate-fm.mjs",
    "check:fm": "node test/check-fm.mjs",
    "altitude:fm": "node test/altitude-fm.mjs",
    "root:guard": "node test/root-guard.mjs",
    "pivot": "node test/pivot.mjs",
    "vendor": "node test/vendor.mjs",
    "upgrade:fm": "node test/upgrade-fm.mjs",
    "registry:fm": "node test/registry-fm.mjs",
    "next:fm": "node test/next-fm.mjs",
    "verdict": "node test/verdict.mjs",
    "edge:schema": "node test/edge-schema.mjs",
    "render": "node test/render.mjs",
    "boot": "node test/boot.mjs",
    "boot:fm": "node test/boot.mjs test/fixtures/front-matter",
    "doc": "node test/doc-endpoint.mjs && node test/status-write.mjs && node test/peek-nav.mjs && node ../plugins/sdlc-factory/hooks/test.mjs",
    "config:code": "node test/config-code.mjs",
    "git:reader": "node test/git-reader.mjs",
    "code:spine": "node test/code-spine.mjs",
    "code:index": "node test/code-index.mjs",
    "system:view": "node test/system-view.mjs",
    "cycle:view": "node test/cycle-view.mjs",
    "impact": "node test/impact.mjs",
    "projects": "node test/projects.mjs",
    "test": "node test/run.mjs"
  }
}
