+      -E DEPLOYER_DRY_INSPECT="${DEPLOYER_DRY_INSPECT:-}" -E DEPLOYER_DRY_OPEN="${DEPLOYER_DRY_OPEN:-}" bash "$SELF" after "$@"
+  else setsid -f bash "$SELF" after "$@" </dev/null >/dev/null 2>&1; fi
+}
