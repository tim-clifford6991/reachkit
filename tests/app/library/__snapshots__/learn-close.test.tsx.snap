exports[`the scans close draws its own icons > about renders as it did outside the glance 1`] = `"<div class="mt-6 flex min-w-0 flex-col gap-6" data-testid="learn-close" data-variant="about"><section id="start" aria-labelledby="start-h" class="rounded-box border-primary/20 bg-primary/10 flex scroll-mt-20 flex-col items-center gap-3.5 border px-5 py-8 text-center sm:px-10 sm:py-12"><h2 id="start-h">See who gets your buyers today</h2><div class="w-full max-w-xl text-start"><form class="flex w-full flex-col gap-2" action="/api/scan" method="post"><label for="_R_eH1_" class="text-sm font-semibold">Your website</label><div class="rounded-box border bg-base-100 flex flex-col gap-2 p-1.5 sm:flex-row border-base-300"><input id="_R_eH1_" type="text" placeholder="yourdomain.com" class="input input-ghost h-12 w-full min-w-0 placeholder:font-mono sm:flex-1" aria-invalid="false" name="value" value=""><button type="submit" class="btn btn-primary h-12 self-start sm:w-auto">Scan my site for free<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button></div></form></div><p class="text-base-content/70 text-sm">free · no account · under a minute</p></section></div>"`;

