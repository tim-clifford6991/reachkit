exports[`the scans close draws its own icons > compare renders as it did outside the glance 1`] = `"<div class="mt-6 flex min-w-0 flex-col gap-6" data-testid="learn-close" data-variant="compare"><section class="flex min-w-0 flex-col gap-4 bg-base-100 py-10 shadow-[0_0_0_100vmax_var(--color-base-100)] [clip-path:inset(0_-100vmax)]"><div class="flex min-w-0 flex-col gap-2"><h2 class="break-words">Tools help. ReachKit does the work.</h2></div><div class="card bg-base-100 shadow-(--shadow-card)"><div class="card-body gap-3"><div aria-hidden="true" class="text-base-content/70 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] gap-3 text-xs font-semibold tracking-wide uppercase"><span>With a tool, you</span><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right mt-0.5" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="text-primary">With ReachKit, we</span></div><ul class="divide-base-300 flex min-w-0 flex-col divide-y"><li class="grid min-w-0 grid-cols-1 gap-1 py-2 sm:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] sm:gap-3"><span class="text-base-content/70 flex min-w-0 items-start gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user mt-1 flex-none" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg><span class="min-w-0">Look up what people search for</span></span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right text-primary hidden sm:block" aria-hidden="true"><path d="M5 12h1