exports[`board PubReport — What we read and the first page say what they hold while closed > WhatWeRead without the report's section renders as before 1`] = `"<section class="card bg-base-100 shadow-(--shadow-card) min-w-0" data-testid="what-we-read"><div class="card-body gap-3"><h2 class="card-title">report.read.title</h2><dl class="grid min-w-0 grid-cols-1 gap-x-6 gap-y-2 text-sm sm:grid-cols-[max-content_minmax(0,1fr)]"><div class="contents"><dt class="text-base-content/70">report.read.name</dt><dd class="min-w-0 break-words ">Example</dd></div><div class="contents"><dt class="text-base-content/70">report.read.sells</dt><dd class="min-w-0 break-words text-base-content/70">report.read.none</dd></div><div class="contents"><dt class="text-base-content/70">report.read.kind</dt><dd class="min-w-0 break-words text-base-content/70">report.read.none</dd></div><div class="contents"><dt class="text-base-content/70">report.read.buyers</dt><dd class="min-w-0 break-words text-base-content/70">report.read.none</dd></div><div class="contents"><dt class="text-base-content/70">report.read.where</dt><dd class="min-w-0 break-words ">report.read.where.unread(United States)</dd></div></dl></div></section>"`;

