# .env.example — every binding a deployment may set (BUILD.md §15). Where each
# lives and who sets it: docs/DEPLOYMENT.md §2. Names only; every value is
# blank — a real credential here is a defect (tests/app/env-example.test.ts).
#
# src/lib/config/env.ts validates the bindings it reads at boot. Two rows here
# sit outside that schema on purpose: DATABASE_URL is the migration and test
# tooling's binding (no module under src/ reads it), and NANO_API_KEY is
# optional — absent, it resolves to ANTHROPIC_API_KEY. MAIL_FROM (#81) and the
# Inngest keys (#315) join this file with their own PRs.

# Supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Resend
RESEND_API_KEY=

# DataForSEO
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Inference
ANTHROPIC_API_KEY=
NANO_API_KEY=

# Compliance / operations (BUILD.md §11, §14)
IP_HASH_SALT=
KILL_SWITCH=
OWNER_EMAILS=

# App
NEXT_PUBLIC_APP_URL=

# Hosted content edge
HOSTED_EDGE_CNAME_TARGET=
